QMainWindow {
    background-color: @bg_dark;
}

QWidget {
    background-color: @bg_dark;
    color: @text_primary;
    font-family: "__UI_FONT__";
    font-size: @font_size_basepx;
}

QLabel {
    background: transparent;
}

QDockWidget {
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
    background-color: @bg_dark;
    border: 1px solid @border_primary;
    margin: 8px;
    border-radius: 4px;
}

QDockWidget::title {
    background-color: @bg_dark;
    padding: 5px;
    font-weight: bold;
    color: @text_on_accent;
}

QGroupBox {
    margin-top: 2ex;
    padding: 12px 8px;
    border: none;
    border-top: 1px solid @border_primary;
    font-weight: bold;
    color: @accent_primary; /* Safelight Red */
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 3px 0 3px;
    color: @text_on_accent;
}

QPushButton {
    background-color: transparent;
    color: @text_primary;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 6px 12px;
}

QPushButton:hover {
    background-color: @border_primary;
    border: 1px solid @border_hover;
}

QPushButton:pressed {
    background-color: @accent_primary;
    color: @text_on_accent;
}

/* Active/checked toggle tools (e.g. "Linear RAW", "Lock Bounds"). Low-key but
   clearly engaged: a warm-tinted fill and a safelight-accent border so the user
   can tell at a glance which tools are currently on. */
QPushButton:checked {
    background-color: @bg_checked;
    color: @text_on_accent;
    border: 1px solid @accent_primary;
    font-weight: 600;
}

QPushButton:checked:hover {
    background-color: @bg_checked_hover;
    border: 1px solid @accent_secondary;
}

/* The Scan panel's commit button: the only control that moves the transport and
   writes files, so it is the one filled button in the app. While a scan runs it
   reads "Stop" and goes hollow — the same accent, but not an invitation. */
QPushButton#scan_btn {
    background-color: @accent_primary;
    color: @text_on_accent;
    border: 1px solid @accent_secondary;
    border-radius: 4px;
    font-weight: 600;
}

QPushButton#scan_btn:hover {
    background-color: @accent_secondary;
    border: 1px solid @accent_secondary;
}

QPushButton#scan_btn:pressed {
    background-color: @accent_pressed;
    color: @text_on_accent;
}

QPushButton#scan_btn:disabled {
    background-color: @bg_accent_muted;
    color: @text_unit;
    border: 1px solid @bg_checked;
}

QPushButton#scan_btn[scanning="true"] {
    background-color: transparent;
    color: @accent_secondary;
    border: 1px solid @accent_primary;
}

QPushButton#scan_btn[scanning="true"]:hover {
    background-color: @bg_checked;
    color: @text_on_accent;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px;
}

QToolButton:hover {
    background-color: @border_primary;
    border: 1px solid @border_hover;
}

QToolButton:checked {
    background-color: @bg_checked;
    border: 1px solid @accent_primary;
}

QToolButton:checked:hover {
    background-color: @bg_checked_hover;
    border: 1px solid @accent_secondary;
}

QSlider::groove:horizontal {
    border: none;
    height: 6px;
    background: @border_primary;
    margin: 2px 0;
    border-radius: 3px;
}

QSlider#neutral_slider::groove:horizontal,
QSlider#cyan_slider::groove:horizontal,
QSlider#magenta_slider::groove:horizontal,
QSlider#yellow_slider::groove:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @border_primary, stop:0.49 @border_primary, stop:0.5 @slider_disabled, stop:0.51 @border_primary, stop:1 @border_primary);
}

QSlider#cyan_slider::handle:horizontal { background: @filter_cyan; }
QSlider#cyan_slider::sub-page:horizontal { background: @border_hover; }

QSlider#magenta_slider::handle:horizontal { background: @filter_magenta; }
QSlider#magenta_slider::sub-page:horizontal { background: @border_hover; }

QSlider#yellow_slider::handle:horizontal { background: @filter_yellow; }
QSlider#yellow_slider::sub-page:horizontal { background: @border_hover; }

QSlider::handle:horizontal {
    background: @accent_primary;
    border: none;
    width: 12px;
    height: 12px;
    margin: -3px 0;
    border-radius: 6px;
}

QSlider::sub-page:horizontal {
    background: @border_hover;
    border-radius: 3px;
}

/* Disabled state — grey out locked/overridden controls. Relies entirely on
   Qt's automatic isEnabled()-driven :disabled propagation from a parent
   widget.setEnabled(False); no per-callsite changes needed. */
QSlider::handle:horizontal:disabled { background: @slider_disabled; }
QSlider::groove:horizontal:disabled { background: @border_input; }
QSlider::sub-page:horizontal:disabled { background: @slider_fill_disabled; }

QSlider#cyan_slider::handle:horizontal:disabled,
QSlider#magenta_slider::handle:horizontal:disabled,
QSlider#yellow_slider::handle:horizontal:disabled { background: @slider_disabled; }

QListView {
    background-color: @bg_dark;
    border: 1px solid @border_primary;
    border-radius: 4px;
}

QListView::item {
    border: 1px solid @border_color;
    border-radius: 4px;
    padding: 5px;
    margin: 4px;
}

QListView::item:selected {
    background-color: @bg_selected;
    border: 1px solid @slider_disabled;
    color: @text_on_accent;
}

QTabWidget::pane {
    border: 1px solid @border_primary;
    background-color: @bg_dark;
    border-radius: 4px;
}

QTabBar::tab {
    background-color: @bg_header;
    color: @text_secondary;
    padding: 8px 12px;
    border: 1px solid @border_color;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background-color: @bg_selected;
    color: @text_on_accent;
    font-weight: bold;
    border-bottom: none;
}

QTabBar::tab:hover:!selected {
    background-color: @border_color;
    color: @text_on_accent;
}

QComboBox, QLineEdit, QDoubleSpinBox, QSpinBox, QTextEdit {
    background-color: @bg_input;
    color: @text_primary;
    border: 1px solid @border_input;
    border-radius: 4px;
    padding: 4px;
}

QComboBox:focus, QLineEdit:focus, QDoubleSpinBox:focus, QSpinBox:focus, QTextEdit:focus {
    border: 1px solid @slider_disabled;
    background-color: @bg_dark;
}

QComboBox:disabled, QLineEdit:disabled, QDoubleSpinBox:disabled, QSpinBox:disabled, QTextEdit:disabled {
    color: @text_muted;
    border: 1px solid @border_input;
}

/* Combo-box dropdown popup. Its a QListView-based view, so without this rule it
   inherits the generic (faint) QListView::item highlight. Match the QMenu
   highlight so hovering a dropdown item reads the same as a right-click menu. */
QComboBox QAbstractItemView {
    background-color: @bg_header;
    border: 1px solid @border_color;
    border-radius: 4px;
    padding: 4px;
    outline: none;
    selection-background-color: @bg_menu_selected;
    selection-color: @text_on_accent;
}

QComboBox QAbstractItemView::item {
    background-color: transparent;
    color: @text_primary;
    border: none;
    border-radius: 3px;
    padding: 5px 12px;
}

QComboBox QAbstractItemView::item:selected,
QComboBox QAbstractItemView::item:hover {
    background-color: @bg_menu_selected;
    color: @text_on_accent;
    /* Override the generic QListView::item:selected slider_disabled border so the
       highlight is a flat fill exactly like the QMenu one (no bordered box). */
    border: none;
}

QPushButton:disabled, QToolButton:disabled { color: @text_muted; }
QCheckBox:disabled { color: @text_muted; }

QStatusBar {
    background-color: @accent_primary;
    color: @text_on_accent;
}

QProgressBar {
    border: 1px solid @border_primary;
    background-color: @bg_card;
    text-align: center;
    border-radius: 4px;
}

QProgressBar::chunk {
    background-color: @accent_primary;
    border-radius: 2px;
}

QScrollArea {
    border: none;
    background-color: @bg_dark;
}

QScrollBar:vertical {
    border: none;
    background: @bg_dark;
    width: 10px;
    margin: 0px 0 0px 0;
}

QScrollBar::handle:vertical {
    background: @border_color;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: @bg_dark;
    height: 10px;
    margin: 0 0px 0 0px;
}

QScrollBar::handle:horizontal {
    background: @border_color;
    min-width: 20px;
    border-radius: 5px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Menus (right-click context menus + dropdowns). Fusion draws no hover state on
   this dark palette, so an item under the cursor looks identical to the rest —
   users can't tell the options are clickable. Give the hovered/selected item a
   clear highlight fill. */
QMenu {
    background-color: @bg_header;
    border: 1px solid @border_color;
    border-radius: 4px;
    padding: 4px;
}

QMenu::item {
    background-color: transparent;
    color: @text_primary;
    padding: 5px 24px 5px 12px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: @bg_menu_selected;
    color: @text_on_accent;
}

QMenu::item:disabled {
    color: @text_muted;
}

QMenu::separator {
    height: 1px;
    background-color: @border_color;
    margin: 4px 8px;
}

/* Tooltip box — match the panel surface and give it a subtle border so the
   rich-text keycap chips sit on a consistent backdrop. */
QToolTip {
    background-color: @bg_header;
    color: @text_primary;
    border: 1px solid @border_color;
    border-radius: 4px;
    padding: 4px 6px;
}

/* Phase 2A — objectName-based rules */

QFrame#collapsible_content {
    background-color: @bg_card;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    border: 1px solid @border_input;
    border-top: none;
}

/* Section content must not repaint over the card: plain QWidget bodies would
   otherwise pick up the global `QWidget` @bg_dark fill and read darker than
   sections whose content is a custom subclass. */
QWidget#collapsible_content_body {
    background: transparent;
}

/* Hint labels (templates.hint_label): informational text under controls. text_hint, not
   text_muted — muted is the disabled-widget grey and too dim to read as copy. */
QLabel[hint="muted"] {
    color: @text_hint;
    font-size: @font_size_smallpx;
    border: none;
}

QLabel[hint="warning"] {
    color: @warn_amber;
    font-size: @font_size_smallpx;
    border: none;
}

QLabel[hint="error"] {
    color: @error;
    font-size: @font_size_smallpx;
    border: none;
}

QPushButton#collapsible_reset_btn {
    background: transparent;
    border: none;
}
QPushButton#collapsible_reset_btn:hover {
    background: @bg_selected;
    border-radius: 3px;
}

QFrame#toolbar_container {
    background-color: @bg_dark;
    border: 1px solid @border_color;
    border-radius: 6px;
    padding: 4px;
}

QFrame#toolbar_separator {
    color: @border_color;
    background-color: @border_color;
}

/* Shortcut overview/Customize dialog rows. Transparent by default so the row
   frame doesn't paint the global @bg_dark over the @bg_card collapsible card;
   the highlighted variant is the jump-to-row flash. */
QFrame#shortcut_editor_row {
    background: transparent;
}

QFrame#shortcut_editor_row[highlighted="true"] {
    background-color: rgba(183, 28, 28, 0.12);
    border-left: 2px solid @accent_primary;
}

QLabel#update_label {
    font-size: @font_size_smallpx;
    color: @status_success;
    font-weight: bold;
    padding: 5px;
}

/* Primary action (Export in the Export panel): solid accent fill so it reads
   as the one call-to-action, not a disabled outline. */
QPushButton[primary="true"], QToolButton[primary="true"] {
    background-color: @accent_primary;
    border: 1px solid @accent_primary;
    color: @text_on_accent;
    font-weight: 600;
}

QPushButton[primary="true"]:hover, QToolButton[primary="true"]:hover {
    background-color: @accent_secondary;
    border: 1px solid @accent_secondary;
}

QPushButton[primary="true"]:pressed, QToolButton[primary="true"]:pressed {
    background-color: @accent_pressed;
    border: 1px solid @accent_pressed;
}

QPushButton[primary="true"]:disabled, QToolButton[primary="true"]:disabled {
    background-color: transparent;
    border: 1px solid @border_primary;
    color: @text_muted;
}

/* Right-panel tab strip (see sidebar/right_panel.py). */
QPushButton#right_tab_btn {
    background-color: @bg_dark;
    border: none;
    border-bottom: 1px solid @border_primary;
    border-right: 1px solid @border_primary;
    border-radius: 0;
}

QPushButton#right_tab_btn:hover {
    background-color: @border_primary;
}

QPushButton#right_tab_btn:checked {
    background-color: @bg_selected;
    border-bottom: none;
}

/* Collapsible section header (see widgets/collapsible.py). [overlay="true"] =
   header stacked over a preview widget (Tone/Color histogram strip). */
QPushButton#collapsible_header {
    text-align: left;
    background-color: @bg_header;
    border: none;
    border-bottom: 1px solid @border_primary;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    color: @text_on_accent;
    padding: 0;
}

QPushButton#collapsible_header:hover {
    background-color: @bg_selected;
}

QPushButton#collapsible_header:checked {
    background-color: @bg_header;
}

QPushButton#collapsible_header[overlay="true"] {
    background-color: @surface_overlay_strong;
}

QPushButton#collapsible_header[overlay="true"]:hover {
    background-color: @surface_overlay_hover;
}

QPushButton#collapsible_header[overlay="true"]:checked {
    background-color: @surface_overlay_strong;
}

/* Preset lists: Export Presets dialog and the Presets sidebar. */
QListWidget#preset_list {
    background: @bg_dark;
    border: 1px solid @border_primary;
}

QListWidget#preset_list::item {
    padding: 8px;
    color: @text_primary;
}

QListWidget#preset_list::item:selected {
    background: @bg_hover;
    color: @text_on_accent;
}

/* Searchable gear combo (widgets/searchable_gear_combo.py): inline arrow + completer popup. */
QToolButton#gear_combo_arrow {
    border: none;
    color: @text_secondary;
    background: transparent;
}

QToolButton#gear_combo_arrow:hover {
    color: @text_primary;
}

/* QCompleter views — the QMenu/combo rules above don't reach them; mirror them.
   Covers the gear combo and the shortcut-dialog search fields. */
QAbstractItemView#gear_combo_popup,
QAbstractItemView#shortcut_editor_search_popup {
    background: @bg_header;
    color: @text_primary;
    border: 1px solid @border_color;
    border-radius: 4px;
    padding: 4px;
    outline: 0;
}

QAbstractItemView#gear_combo_popup::item,
QAbstractItemView#shortcut_editor_search_popup::item {
    background: transparent;
    border: none;
    border-radius: 3px;
    padding: 5px 12px;
}

QAbstractItemView#gear_combo_popup::item:selected,
QAbstractItemView#gear_combo_popup::item:hover,
QAbstractItemView#shortcut_editor_search_popup::item:selected,
QAbstractItemView#shortcut_editor_search_popup::item:hover {
    background: @bg_menu_selected;
    color: @text_on_accent;
    border: none;
}

/* Darker red divider between the two halves of a primary split button. */
QToolButton#split_menu_btn[primary="true"] {
    border-left: 1px solid @accent_pressed;
}

/* Fused split button (main action + menu arrow), see widgets/split_button.py. */
QPushButton#split_main_btn {
    text-align: center;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-right: none;
}

QToolButton#split_menu_btn {
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-left: 1px solid @border_hover;
    padding: 6px 4px;
}

QToolButton#split_menu_btn::menu-button {
    width: 0px;
    border: none;
    padding: 0px;
}

QToolButton#split_menu_btn::menu-arrow {
    image: none;
    width: 0px;
    height: 0px;
}

/* Checkboxes — Fusion's default indicator is almost invisible on this dark
   background. Give the unchecked box a clear border + subtle fill, and a filled
   accent when checked, so its state reads at a glance. */
QCheckBox {
    spacing: 6px;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border-radius: 3px;
    border: 1px solid @border_indicator;
    background-color: @bg_indicator;
}

QCheckBox::indicator:hover {
    border: 1px solid @border_indicator_hover;
    background-color: @bg_indicator_hover;
}

QCheckBox::indicator:checked {
    background-color: @accent_primary;
    border: 1px solid @accent_secondary;
    image: url("__CHECKBOX_CHECK_ICON__");
}

QCheckBox::indicator:checked:hover {
    background-color: @accent_secondary;
    border: 1px solid @accent_secondary;
    image: url("__CHECKBOX_CHECK_ICON__");
}

QCheckBox::indicator:disabled {
    border: 1px solid @border_color;
    background-color: @bg_indicator_disabled;
}

/* Radio buttons — Fusion's indicator is as faint on this background as the checkbox one,
   and the scan-setup pages are built entirely from radios. Same box as QCheckBox, round. */
QRadioButton {
    spacing: 6px;
}

QRadioButton::indicator {
    width: 15px;
    height: 15px;
    border-radius: 8px;
    border: 1px solid @border_indicator;
    background-color: @bg_indicator;
}

QRadioButton::indicator:hover {
    border: 1px solid @border_indicator_hover;
    background-color: @bg_indicator_hover;
}

/* A dot inside the ring, not a filled box: a border thick enough to read as a dot eats the
   corner radius and the indicator turns square. */
QRadioButton::indicator:checked {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
        stop:0 @accent_primary, stop:0.5 @accent_primary, stop:0.55 @bg_indicator, stop:1 @bg_indicator);
    border: 1px solid @accent_primary;
}

QRadioButton::indicator:checked:hover {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
        stop:0 @accent_secondary, stop:0.5 @accent_secondary, stop:0.55 @bg_indicator_hover, stop:1 @bg_indicator_hover);
    border: 1px solid @accent_secondary;
}

QRadioButton::indicator:disabled {
    border: 1px solid @border_color;
    background-color: @bg_indicator_disabled;
}

QRadioButton:disabled {
    color: @text_muted;
}

/* Keyboard focus. A styled QPushButton loses Fusion's focus rect, so tabbing through a
   panel or a dialog footer moves an invisible cursor. Marked with the accent border the
   checked state uses, one step brighter. */
QPushButton:focus, QToolButton:focus {
    border: 1px solid @accent_secondary;
}

QCheckBox::indicator:focus, QRadioButton::indicator:focus {
    border-color: @accent_secondary;
}

/* The ring grows inward: a 2px border on a 12px content box would make the
   handle 16px wide while the groove clamps its height, so it reads as an egg. */
QSlider::handle:horizontal:focus {
    border: 2px solid @text_on_accent;
    width: 8px;
    height: 8px;
    margin: -3px 0;
    border-radius: 6px;
}
