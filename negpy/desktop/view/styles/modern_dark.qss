QMainWindow {
    background-color: #0D0D0D;
}

QWidget {
    background-color: #0D0D0D;
    color: #D4D4D4;
    font-family: "Inter", "Segoe UI", "Roboto", "Arial";
    font-size: 10pt;
}

QDockWidget {
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
    background-color: #0D0D0D;
    border: 1px solid #262626;
    margin: 8px;
}

QDockWidget::title {
    background-color: #0D0D0D;
    padding: 5px;
    font-weight: bold;
    color: #FFFFFF;
}

QGroupBox {
    margin-top: 2ex;
    padding: 12px 8px;
    border: none;
    border-top: 1px solid #262626;
    font-weight: bold;
    color: #B71C1C; /* Safelight Red */
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 3px 0 3px;
    color: #FFFFFF;
}

QPushButton {
    background-color: #0D0D0D;
    color: #D4D4D4;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 6px 12px;
}

QPushButton:hover {
    background-color: #333333;
    border: 1px solid #B71C1C;
}

QPushButton:pressed {
    background-color: #B71C1C;
    color: white;
}

QPushButton:checked {
    background-color: #B71C1C;
    color: white;
    border: 1px solid #B71C1C;
}

/* Primary Action Styling */
QPushButton#export_btn, QPushButton#batch_export_btn {
    background-color: #B71C1C;
    color: #FFFFFF;
    font-weight: bold;
}

QPushButton#export_btn:hover, QPushButton#batch_export_btn:hover {
    background-color: #C62828;
}

QToolButton {
    background-color: #0D0D0D;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 4px;
}

QToolButton:hover {
    background-color: #333333;
    border: 1px solid #B71C1C;
}

QSlider::groove:horizontal {
    border: none;
    height: 6px;
    background: #262626;
    margin: 2px 0;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #B71C1C;
    border: none;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}

QSlider::sub-page:horizontal {
    background: #441111;
    border-radius: 3px;
}

QListView {
    background-color: #0D0D0D;
    border: 1px solid #262626;
}

QListView::item {
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 5px;
    margin: 4px;
}

QListView::item:selected {
    background-color: #B71C1C;
    border: 1px solid #C62828;
    color: white;
}

QTabWidget::pane {
    border: 1px solid #262626;
    background-color: #0D0D0D;
}

QTabBar::tab {
    background-color: #161616;
    color: #A0A0A0;
    padding: 8px 12px;
    border: 1px solid #333333;
}

QTabBar::tab:selected {
    background-color: #222222;
    color: #FFFFFF;
    font-weight: bold;
    border-bottom: none;
}

QTabBar::tab:hover:!selected {
    background-color: #333333;
    color: #FFFFFF;
}

QComboBox, QLineEdit, QDoubleSpinBox, QSpinBox, QTextEdit {
    background-color: #121212;
    color: #D4D4D4;
    border: 1px solid #333333;
    border-radius: 3px;
    padding: 4px;
}

QComboBox:focus, QLineEdit:focus, QDoubleSpinBox:focus, QSpinBox:focus, QTextEdit:focus {
    border: 1px solid #B71C1C;
}

QStatusBar {
    background-color: #B71C1C;
    color: white;
}

QProgressBar {
    border: 1px solid #262626;
    background-color: #121212;
    text-align: center;
    border-radius: 3px;
}

QProgressBar::chunk {
    background-color: #B71C1C;
}

QScrollArea {
    border: none;
    background-color: #0D0D0D;
}

QScrollBar:vertical {
    border: none;
    background: #0D0D0D;
    width: 10px;
    margin: 0px 0 0px 0;
}

QScrollBar::handle:vertical {
    background: #333333;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
